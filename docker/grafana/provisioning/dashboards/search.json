{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "turbo-rag search latency and throughput",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Query Throughput (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(turborag_queries_total)",
          "legendFormat": "total queries",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Search Latency p50 (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(turborag_search_latency_ms_bucket[5m]))",
          "legendFormat": "p50 ms",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 3,
      "title": "Search Latency p99 (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(turborag_search_latency_ms_bucket[5m]))",
          "legendFormat": "p99 ms",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "title": "Search Latency Histogram by Mode",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(turborag_search_latency_ms_bucket[1m])) by (le, mode))",
          "legendFormat": "p50 mode={{mode}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(turborag_search_latency_ms_bucket[1m])) by (le, mode))",
          "legendFormat": "p99 mode={{mode}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "title": "Embed Latency p50/p99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(turborag_embed_latency_ms_bucket[5m]))",
          "legendFormat": "embed p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(turborag_embed_latency_ms_bucket[5m]))",
          "legendFormat": "embed p99",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 6,
      "title": "Queries by Mode",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "turborag_queries_total",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "options": { "pieType": "pie" }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["turbo-rag", "search"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "turbo-rag: Search Performance",
  "uid": "turbo-rag-search",
  "version": 1
}
