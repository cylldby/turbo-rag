# turbo-rag environment configuration
# Copy to .env and fill in values. All variables can also be set as env vars.
# Config precedence: config/default.toml < .env < env vars < CLI flags

# ── Embedding Backend ──────────────────────────────────────────────────────────
# fastembed   — local ONNX, no API key, model download on first run
# openai-compat — Ollama, OpenAI, Voyage AI, Azure (same HTTP API)
# synthetic   — random vectors, for benchmarks only
EMBEDDING__BACKEND=openai-compat

# For openai-compat: base URL and API key
EMBEDDING__BASE_URL=http://localhost:11434/v1
EMBEDDING__API_KEY=
EMBEDDING__MODEL=nomic-embed-text
EMBEDDING__DIM=768

# Alternative: Voyage AI free tier (1024-dim, 50M free tokens)
# EMBEDDING__BASE_URL=https://api.voyageai.com/v1
# EMBEDDING__API_KEY=your-voyage-key
# EMBEDDING__MODEL=voyage-large-2
# EMBEDDING__DIM=1024

# Alternative: OpenAI (1536-dim, paid)
# EMBEDDING__BASE_URL=https://api.openai.com/v1
# EMBEDDING__API_KEY=sk-...
# EMBEDDING__MODEL=text-embedding-3-small
# EMBEDDING__DIM=1536

# ── Blob Storage ───────────────────────────────────────────────────────────────
# local — local filesystem (default for dev)
# s3    — S3-compatible: MinIO (test) or AWS S3 / GCS (prod)
BLOB__BACKEND=local
BLOB__LOCAL_PATH=./data/blob
BLOB__BUCKET=turbo-rag-dev

# For S3 / MinIO:
# AWS_ENDPOINT_URL=http://localhost:9000   # omit for real AWS; required for MinIO
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1

# ── LanceDB ────────────────────────────────────────────────────────────────────
# Local filesystem (dev):
LANCE__URI=./data/lance

# S3-native (integration test / prod):
# LANCE__URI=s3://turbo-rag-dev/lance

# ── Pipeline ───────────────────────────────────────────────────────────────────
PIPELINE__BATCH_SIZE=64
PIPELINE__TURBOVEC_BITS=4         # 2 or 4
PIPELINE__LOAD_STRATEGY=lazy      # from-blob | rebuild-from-lance | lazy

# ── Search ─────────────────────────────────────────────────────────────────────
SEARCH__MODE=auto                 # hot | cold | race | federated | auto
