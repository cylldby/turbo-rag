# CI / integration test environment — points to Docker Compose services
EMBEDDING__BACKEND=openai-compat
EMBEDDING__BASE_URL=http://localhost:8080/v1
EMBEDDING__API_KEY=
EMBEDDING__MODEL=mock-embed
EMBEDDING__DIM=768

BLOB__BACKEND=s3
BLOB__BUCKET=turbo-rag-dev
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

LANCE__URI=./data/lance-test

PIPELINE__BATCH_SIZE=32
PIPELINE__TURBOVEC_BITS=4
PIPELINE__LOAD_STRATEGY=from-blob

SEARCH__MODE=auto
